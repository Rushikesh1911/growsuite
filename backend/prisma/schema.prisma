// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── AUTH & TENANCY ─────────────────────────────────────────────────────────

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String?
  jobTitle       String?
  emailSignature String?
  emailVerified  DateTime?
  verificationToken String?
  avatarUrl      String?
  createdAt      DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Preferences
  themePreference String @default("system")
  timezone        String @default("Asia/Kolkata")
  dateFormat      String @default("DD/MM/YYYY")
  notificationPreferences Json?
  phone           String?

  hasCompletedOnboarding Boolean @default(false)
  hideOnboardingChecklist Boolean @default(false)

  // Billing
  hourlyRate Int?

  // Google OAuth
  googleAccessToken  String?
  googleRefreshToken String?
  googleTokenExpiry  DateTime?

  workspaceMemberships WorkspaceMember[]
  activityLogs         ActivityLog[]     @relation("ActivityActor")
  notifications        Notification[]
  sentInvitations      WorkspaceInvitation[] @relation("InvitationSender")
  sentEmails           EmailMessage[]
  attachments          Attachment[]
  timeEntries          TimeEntry[]
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

model Workspace {
  id        Int      @id @default(autoincrement())
  name       String
  currency   String   @default("INR")
  timezone   String   @default("Asia/Kolkata")
  dateFormat String   @default("DD/MM/YYYY")
  logoUrl    String?
  razorpayKeyId String?
  razorpayKeySecret String?
  useCase    String?
  brandColor String   @default("#EDEDED")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  subscription Subscription?
  members      WorkspaceMember[]
  leads        Lead[]
  deals        Deal[]
  clients      Client[]
  projects     Project[]
  tasks        Task[]
  invoices     Invoice[]
  payments     Payment[]
  activityLogs ActivityLog[]
  notifications Notification[]
  invitations   WorkspaceInvitation[]
  emails        EmailMessage[]
  clientNotes   ClientNote[]
  leadNotes     LeadNote[]
  dealNotes     DealNote[]
  attachments   Attachment[]
  timeEntries   TimeEntry[]
}

model WorkspaceMember {
  id          Int           @id @default(autoincrement())
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      Int
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId Int

  assignedTasks Task[] @relation("TaskAssignee")
  assignedLeads Lead[] @relation("LeadAssignee")
  clientNotes   ClientNote[]
  leadNotes     LeadNote[]
  dealNotes     DealNote[]

  @@unique([userId, workspaceId])
}

// ─── BILLING & SUBSCRIPTIONS ────────────────────────────────────────────────

enum SubscriptionPlan {
  FREE
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  INCOMPLETE
  PAUSED
}

enum BillingProvider {
  RAZORPAY
  STRIPE
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

model Subscription {
  id                     Int                @id @default(autoincrement())
  
  workspaceId            Int                @unique
  workspace              Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  
  plan                   SubscriptionPlan   @default(FREE)
  status                 SubscriptionStatus @default(ACTIVE)
  provider               BillingProvider?
  
  providerCustomerId     String?
  providerSubscriptionId String?            @unique
  
  billingCycle           BillingCycle?
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  trialStart             DateTime?
  trialEnd               DateTime?
  canceledAt             DateTime?
  cancelAtPeriodEnd      Boolean            @default(false)

  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
}


// ─── CRM (LEADS, DEALS & CLIENTS) ───────────────────────────────────────────

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  DISQUALIFIED
}

model Lead {
  id             Int       @id @default(autoincrement())
  contactName    String
  company        String?
  email          String?
  phone          String?
  source         String?
  status         LeadStatus @default(NEW)
  notes          String?
  
  // conversion tracking
  convertedAt    DateTime?
  convertedDealId Int?      @unique
  convertedDeal  Deal?      @relation(fields: [convertedDealId], references: [id], onDelete: SetNull)

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  archivedAt     DateTime?

  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId    Int

  assignee       WorkspaceMember? @relation("LeadAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  assigneeId     Int?

  activities     ActivityLog[]
  emails         EmailMessage[]
  leadNotes      LeadNote[]
}

enum DealStage {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

model Deal {
  id             Int       @id @default(autoincrement())
  title          String
  company        String?
  contactName    String?
  contactEmail   String?
  contactPhone   String?
  stage          DealStage @default(NEW)
  estimatedValue Decimal   @db.Decimal(12, 2)
  probability    Int?      
  expectedClose  DateTime?
  notes          String?

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  archivedAt     DateTime?

  originalLead   Lead?

  // Conversion tracking
  convertedToClientId Int?      @unique
  convertedToClient   Client?   @relation("DealToClient", fields: [convertedToClientId], references: [id], onDelete: SetNull)

  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId    Int

  activities     ActivityLog[]
  tasks          Task[]
  dealNotes      DealNote[]
}

model Client {
  id             Int       @id @default(autoincrement())
  name           String
  company        String
  email          String?
  phone          String?
  billingAddress String?
  
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  archivedAt     DateTime?

  // Inverse of conversion
  originalDeal   Deal?     @relation("DealToClient")

  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId    Int

  projects       Project[]
  invoices       Invoice[]
  activities     ActivityLog[]
  emails         EmailMessage[]
  clientNotes    ClientNote[]
}

model ClientNote {
  id          Int      @id @default(autoincrement())
  content     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  clientId    Int
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  authorId    Int
  author      WorkspaceMember @relation(fields: [authorId], references: [id], onDelete: Cascade)

  workspaceId Int
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model LeadNote {
  id          Int      @id @default(autoincrement())
  content     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  leadId      Int
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  authorId    Int
  author      WorkspaceMember @relation(fields: [authorId], references: [id], onDelete: Cascade)

  workspaceId Int
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model DealNote {
  id          Int      @id @default(autoincrement())
  content     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  dealId      Int
  deal        Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)

  authorId    Int
  author      WorkspaceMember @relation(fields: [authorId], references: [id], onDelete: Cascade)

  workspaceId Int
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

// ─── EXECUTION (PROJECTS & TASKS) ───────────────────────────────────────────

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

model Project {
  id          Int           @id @default(autoincrement())
  name        String
  description String?
  status      ProjectStatus @default(PLANNING)
  deadline    DateTime?
  
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  archivedAt  DateTime?

  client      Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId    Int

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId Int

  hourlyRate  Int?

  tasks       Task[]
  invoices    Invoice[]
  activities  ActivityLog[]
  attachments Attachment[]
  timeEntries TimeEntry[]
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

enum TaskPriority {
  NONE
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Task {
  id          Int        @id @default(autoincrement())
  title       String
  description String?
  status      TaskStatus @default(TODO)
  priority    TaskPriority @default(NONE)
  dueDate     DateTime?

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  archivedAt  DateTime?

  project     Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   Int?

  deal        Deal?     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  dealId      Int?

  assignee    WorkspaceMember? @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  assigneeId  Int?

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId Int

  // Google Calendar Integration
  googleEventId String?

  activities  ActivityLog[]
  attachments Attachment[]
  timeEntries TimeEntry[]
}

// ─── FINANCE (INVOICES & PAYMENTS) ──────────────────────────────────────────

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
}

model Invoice {
  id            Int           @id @default(autoincrement())
  invoiceNumber String        @unique
  status        InvoiceStatus @default(DRAFT)
  issueDate     DateTime      @default(now())
  dueDate       DateTime
  
  subtotal      Decimal       @db.Decimal(12, 2)
  tax           Decimal       @db.Decimal(12, 2) @default(0.00)
  discount      Decimal       @db.Decimal(12, 2) @default(0.00)
  total         Decimal       @db.Decimal(12, 2)
  amountPaid    Decimal       @db.Decimal(12, 2) @default(0.00)
  balanceDue    Decimal       @db.Decimal(12, 2)
  
  currency      String        @default("USD")
  notes         String?

  razorpayOrderId String?
  razorpayPaymentId String?

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  sentAt        DateTime?
  archivedAt    DateTime?

  client        Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId      Int

  project       Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId     Int?

  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId   Int

  items         InvoiceItem[]
  payments      Payment[]
  activities    ActivityLog[]
  timeEntries   TimeEntry[]
}

model InvoiceItem {
  id          Int     @id @default(autoincrement())
  description String
  quantity    Int     @default(1)
  unitPrice   Decimal @db.Decimal(12, 2)
  total       Decimal @db.Decimal(12, 2)

  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId   Int
}

model Payment {
  id          Int      @id @default(autoincrement())
  amount      Decimal  @db.Decimal(12, 2)
  date        DateTime @default(now())
  method      String?
  reference   String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  invoice     Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId   Int

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId Int

  activities  ActivityLog[]
}

// ─── UNIFIED ACTIVITY TIMELINE ──────────────────────────────────────────────

model ActivityLog {
  id          Int      @id @default(autoincrement())
  action      String   // e.g. "LEAD_CREATED", "STAGE_CHANGED", "PAYMENT_RECEIVED"
  title       String
  description String?
  metadata    Json?
  
  createdAt   DateTime @default(now())

  // Actor
  actor       User?    @relation("ActivityActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorId     Int?

  // Workspace Context
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId Int

  // Explicit Nullable Foreign Keys for Integrity
  lead        Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  leadId      Int?

  deal        Deal?    @relation(fields: [dealId], references: [id], onDelete: SetNull)
  dealId      Int?

  client      Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientId    Int?

  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId   Int?

  task        Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  taskId      Int?

  invoice     Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  invoiceId   Int?

  payment     Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  paymentId   Int?
}

// ─── NOTIFICATIONS ──────────────────────────────────────────────────────────

model Notification {
  id          Int      @id @default(autoincrement())
  title       String
  body        String?
  type        String   // e.g., 'TASK_ASSIGNED', 'INVOICE_PAID', 'MENTION'
  isRead      Boolean  @default(false)
  link        String?

  createdAt   DateTime @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      Int
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId Int
}

// ─── INVITATIONS ────────────────────────────────────────────────────────────

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model WorkspaceInvitation {
  id          String   @id @default(uuid())
  email       String
  role        WorkspaceRole @default(MEMBER)
  status      InvitationStatus @default(PENDING)
  
  createdAt   DateTime @default(now())
  expiresAt   DateTime

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId Int

  inviter     User      @relation("InvitationSender", fields: [inviterId], references: [id], onDelete: Cascade)
  inviterId   Int

  @@unique([email, workspaceId])
}

// ─── COMMUNICATIONS (EMAILS) ────────────────────────────────────────────────

enum EmailStatus {
  PENDING
  SENT
  FAILED
}

model EmailMessage {
  id          String      @id @default(cuid())

  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId Int

  sender      User        @relation(fields: [senderId], references: [id], onDelete: Cascade)
  senderId    Int

  lead        Lead?       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId      Int?

  client      Client?     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId    Int?

  toEmail     String
  subject     String
  body        String

  status      EmailStatus @default(PENDING)

  messageId   String?
  sentAt      DateTime?
  failedAt    DateTime?
  error       String?

  createdAt   DateTime    @default(now())
}

model Attachment {
  id          Int      @id @default(autoincrement())
  fileName    String
  fileUrl     String
  fileType    String
  size        Int
  
  projectId   Int?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  taskId      Int?
  task        Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  
  uploadedById Int
  uploadedBy  User     @relation(fields: [uploadedById], references: [id])
  
  workspaceId Int
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())
}

// ─── TIME TRACKING ──────────────────────────────────────────────────────────

model TimeEntry {
  id          Int      @id @default(autoincrement())
  description String?
  duration    Int      @default(0) // Total duration in seconds, computed on stop
  startTime   DateTime? // Set if a timer is currently running
  endTime     DateTime?
  billable    Boolean  @default(true)
  
  // Note: "billed" is derived from invoiceId != null.
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      Int
  
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId Int
  
  task        Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId      Int?
  
  project     Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   Int?
  
  invoice     Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  invoiceId   Int?
}
